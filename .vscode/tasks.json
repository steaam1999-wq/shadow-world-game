{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Match: установить зависимости",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "Match: запустить для разработки",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Match: собрать в один файл",
      "type": "shell",
      "command": "npm run build:single",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    }
  ]
}
