<Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Все настройки баланса и монетизации в одном месте.
-- Меняйте цифры здесь — сервер и интерфейс подхватят их автоматически.
-- Баланс совпадает с браузерным прототипом (web-prototype/index.html).

local Config = {}

---------------------------------------------------------------------
-- Данные
---------------------------------------------------------------------
-- Если поменять имя — у всех игроков начнётся новый прогресс.
Config.DataStoreName = "ShadowWorld_PlayerData_v2"
Config.AutosaveInterval = 120 -- секунд

---------------------------------------------------------------------
-- Мир
---------------------------------------------------------------------
Config.World = {
	ZoneSize = 120, -- размер платформы зоны (studs)
	ZoneGap = 24, -- расстояние между зонами (там мост)
	RemoveDefaultBaseplate = true, -- удалить стандартный Baseplate шаблона
	ApplyLighting = true, -- ночная «теневая» атмосфера
}

-- price — цена открытия зоны, eggPrice — цена яйца питомца этой зоны.
-- shadowHp — здоровье тени, shadowValue — базовая награда.
-- ambient — эффект частиц зоны: fireflies, fog, embers, snow, void.
Config.Zones = {
	{
		name = "Сумеречный лес",
		price = 0,
		eggPrice = 200,
		shadowHp = 3,
		shadowValue = 1,
		floorColor = Color3.fromRGB(46, 58, 52),
		shadowColor = Color3.fromRGB(22, 16, 40),
		glowColor = Color3.fromRGB(160, 110, 255),
		ambient = "fireflies",
		ambientColor = Color3.fromRGB(210, 255, 130),
	},
	{
		name = "Туманные болота",
		price = 500,
		eggPrice = 2500,
		shadowHp = 12,
		shadowValue = 6,
		floorColor = Color3.fromRGB(44, 64, 68),
		shadowColor = Color3.fromRGB(16, 36, 44),
		glowColor = Color3.fromRGB(90, 225, 185),
		ambient = "fog",
		ambientColor = Color3.fromRGB(170, 235, 215),
	},
	{
		name = "Пепельные руины",
		price = 5000,
		eggPrice = 30000,
		shadowHp = 40,
		shadowValue = 25,
		floorColor = Color3.fromRGB(70, 46, 38),
		shadowColor = Color3.fromRGB(48, 16, 12),
		glowColor = Color3.fromRGB(255, 125, 60),
		ambient = "embers",
		ambientColor = Color3.fromRGB(255, 160, 70),
	},
	{
		name = "Ледяной склеп",
		price = 50000,
		eggPrice = 350000,
		shadowHp = 150,
		shadowValue = 120,
		floorColor = Color3.fromRGB(70, 90, 115),
		shadowColor = Color3.fromRGB(18, 30, 66),
		glowColor = Color3.fromRGB(135, 215, 255),
		ambient = "snow",
		ambientColor = Color3.fromRGB(235, 248, 255),
	},
	{
		name = "Бездна",
		price = 500000,
		eggPrice = 4000000,
		shadowHp = 600,
		shadowValue = 600,
		floorColor = Color3.fromRGB(34, 16, 50),
		shadowColor = Color3.fromRGB(56, 0, 88),
		glowColor = Color3.fromRGB(255, 80, 215),
		ambient = "void",
		ambientColor = Color3.fromRGB(255, 130, 245),
	},
}

---------------------------------------------------------------------
-- Тени
---------------------------------------------------------------------
Config.ShadowsPerZone = 8
Config.ShadowRespawnTime = 2.5 -- секунд
Config.ClickCooldown = 0.08 -- защита от автокликеров (секунд между ударами)
Config.ClickRange = 32 -- с какого расстояния можно кликнуть по тени
Config.AutoCatchInterval = 0.5 -- как часто бьёт авто-ловля (Game Pass)
Config.AutoCatchRange = 30
Config.SpiritInterval = 1 -- как часто стреляет дух-помощник
Config.SpiritRange = 40

-- Золотые тени: появляются случайно, быстрые и ценные.
Config.Golden = {
	spawnChance = 0.03,
	hpMultiplier = 2,
	rewardMultiplier = 10,
	gems = 1,
	xpMultiplier = 5,
}

-- Хранитель зоны: появляется, когда в зоне поймано N теней (всеми игроками сервера).
Config.Boss = {
	kills = 25,
	hpMultiplier = 50,
	duration = 60, -- секунд на победу
	rewardMultiplier = 60, -- награда каждому, кто нанёс урон
	gemsPerZone = 3,
	xpMultiplier = 25,
	retryKills = 15, -- если Хранитель ушёл, счётчик откатывается сюда
}

-- Комбо: быстрые удары подряд дают до +50% эссенции.
Config.Combo = {
	window = 0.8, -- секунд между ударами, чтобы комбо не сбросилось
	max = 50,
	perHit = 0.01,
}

function Config.ComboMultiplier(combo: number): number
	return 1 + math.min(combo, Config.Combo.max) * Config.Combo.perHit
end

---------------------------------------------------------------------
-- Характеристики (улучшения за эссенцию)
---------------------------------------------------------------------
Config.Upgrades = {
	power = {
		icon = "🔦",
		name = "Сила фонаря",
		description = "Больше урона за каждый удар",
		baseCost = 10,
		growth = 1.45,
		maxLevel = 300,
	},
	crit = {
		icon = "🎯",
		name = "Шанс крита",
		description = "Шанс нанести критический удар",
		baseCost = 60,
		growth = 1.75,
		maxLevel = 50,
	},
	critDamage = {
		icon = "💥",
		name = "Сила крита",
		description = "Во сколько раз крит сильнее",
		baseCost = 90,
		growth = 1.7,
		maxLevel = 40,
	},
	greed = {
		icon = "💰",
		name = "Жадность",
		description = "Больше эссенции за каждую тень",
		baseCost = 25,
		growth = 1.55,
		maxLevel = 200,
	},
	luck = {
		icon = "🍀",
		name = "Удача",
		description = "Шанс счастливой ловли: x10 эссенции и 💎",
		baseCost = 120,
		growth = 1.85,
		maxLevel = 30,
	},
	spirit = {
		icon = "✨",
		name = "Дух-помощник",
		description = "Питомцы сами атакуют ближайших теней",
		baseCost = 200,
		growth = 1.6,
		maxLevel = 150,
	},
	speed = {
		icon = "👟",
		name = "Теневой шаг",
		description = "Быстрее бег по миру",
		baseCost = 50,
		growth = 2.2,
		maxLevel = 10,
	},
}
Config.UpgradeOrder = { "power", "crit", "critDamage", "greed", "luck", "spirit", "speed" }

function Config.UpgradeCost(id: string, level: number): number
	local def = Config.Upgrades[id]
	return math.floor(def.baseCost * def.growth ^ level)
end

function Config.CritChance(level: number): number
	return math.min(0.55, 0.05 + 0.01 * level)
end

function Config.CritMultiplier(level: number): number
	return 2 + 0.25 * level
end

function Config.LuckyChance(level: number): number
	return 0.02 + 0.005 * level
end

function Config.GreedMultiplier(level: number): number
	return 1 + 0.1 * level
end

function Config.WalkSpeed(speedLevel: number, isVip: boolean): number
	return 16 + 2 * speedLevel + (if isVip then 4 else 0)
end

-- Короткое описание эффекта улучшения на уровне level (для интерфейса).
function Config.UpgradeEffect(id: string, level: number): string
	if id == "power" then
		return string.format("%d базового урона", 1 + level)
	elseif id == "crit" then
		return string.format("%d%%", math.round(Config.CritChance(level) * 100))
	elseif id == "critDamage" then
		return string.format("x%.2f", Config.CritMultiplier(level))
	elseif id == "greed" then
		return string.format("+%d%% эссенции", level * 10)
	elseif id == "luck" then
		return string.format("%.1f%% шанс", Config.LuckyChance(level) * 100)
	elseif id == "spirit" then
		return if level > 0 then string.format("%d%% урона/сек", level * 30) else "нет"
	elseif id == "speed" then
		return string.format("скорость %d", Config.WalkSpeed(level, false))
	end
	return ""
end

---------------------------------------------------------------------
-- Уровень игрока
---------------------------------------------------------------------
function Config.XpNeeded(level: number): number
	return math.floor(8 * level ^ 1.6)
end

function Config.LevelMultiplier(level: number): number
	return 1 + 0.03 * (level - 1) -- +3% эссенции за уровень
end

function Config.LevelDamageMultiplier(level: number): number
	return 1 + 0.01 * (level - 1) -- +1% урона за уровень
end

---------------------------------------------------------------------
-- Питомцы
---------------------------------------------------------------------
Config.Pets = {
	slots = 3, -- сколько можно надеть (+1 с Game Pass PetSlot)
	inventory = 40,
	goldEggPrice = 25, -- 💎
	eggOdds = { common = 0.62, rare = 0.27, epic = 0.09, legendary = 0.02 },
	goldEggOdds = { common = 0.30, rare = 0.40, epic = 0.22, legendary = 0.08 },
}

Config.RarityOrder = { "common", "rare", "epic", "legendary" }
Config.Rarities = {
	common = { name = "Обычный", color = Color3.fromRGB(185, 179, 204), essence = 0.10, damage = 0.00 },
	rare = { name = "Редкий", color = Color3.fromRGB(79, 163, 255), essence = 0.25, damage = 0.05 },
	epic = { name = "Эпический", color = Color3.fromRGB(192, 107, 255), essence = 0.60, damage = 0.20 },
	legendary = { name = "Легендарный", color = Color3.fromRGB(255, 176, 32), essence = 1.50, damage = 0.50 },
}

Config.PetPool = {
	common = {
		{ emoji = "🦇", name = "Ночная мышь" },
		{ emoji = "🕷️", name = "Паучок" },
		{ emoji = "🐀", name = "Подвальная крыса" },
	},
	rare = {
		{ emoji = "🐈‍⬛", name = "Теневой кот" },
		{ emoji = "🦉", name = "Сова-призрак" },
	},
	epic = {
		{ emoji = "👻", name = "Фантом" },
		{ emoji = "🐺", name = "Лунный волк" },
	},
	legendary = {
		{ emoji = "🐉", name = "Дракон Бездны" },
		{ emoji = "🔮", name = "Око тьмы" },
	},
}

-- pet = { uid = "...", rarity = "rare", kind = 1, tier = 2 }
function Config.PetInfo(pet)
	local pool = Config.PetPool[pet.rarity] or Config.PetPool.common
	return pool[pet.kind] or pool[1]
end

-- Возвращает бонус питомца: доля эссенции, доля урона.
function Config.PetStats(pet): (number, number)
	local rarity = Config.Rarities[pet.rarity] or Config.Rarities.common
	local tierFactor = 1 + (pet.tier - 1) * 0.75
	return rarity.essence * tierFactor, rarity.damage * tierFactor
end

function Config.PetPower(pet): number
	local essence, damage = Config.PetStats(pet)
	return essence + damage * 1.5
end

function Config.FindPet(data, uid: string)
	for _, pet in data.pets do
		if pet.uid == uid then
			return pet
		end
	end
	return nil
end

function Config.PetBonus(data): (number, number)
	local essence, damage = 0, 0
	for _, uid in data.equipped do
		local pet = Config.FindPet(data, uid)
		if pet then
			local e, d = Config.PetStats(pet)
			essence += e
			damage += d
		end
	end
	return essence, damage
end

function Config.PetSlots(passes): number
	return Config.Pets.slots + (if passes.PetSlot then 1 else 0)
end

---------------------------------------------------------------------
-- Боевые формулы (используют и сервер, и интерфейс)
---------------------------------------------------------------------
function Config.TapDamage(data): number
	local _, petDamage = Config.PetBonus(data)
	return (1 + data.upgrades.power) * (1 + petDamage) * Config.LevelDamageMultiplier(data.level)
end

function Config.SpiritDamage(data): number
	if data.upgrades.spirit <= 0 then
		return 0
	end
	return Config.TapDamage(data) * 0.3 * data.upgrades.spirit
end

function Config.EssenceMultiplier(data, passes, now: number): number
	local petEssence = Config.PetBonus(data)
	local multiplier = Config.GreedMultiplier(data.upgrades.greed)
		* Config.RebirthMultiplier(data.rebirths)
		* Config.LevelMultiplier(data.level)
		* (1 + petEssence)
	if passes.DoubleEssence then
		multiplier *= 2
	end
	if passes.VIP then
		multiplier *= 1.5
	end
	if (data.boostEndsAt or 0) > now then
		multiplier *= 2
	end
	return multiplier
end

---------------------------------------------------------------------
-- Перерождение
---------------------------------------------------------------------
Config.Rebirth = {
	baseCost = 25000,
	growth = 3,
	multiplierPerRebirth = 0.5, -- +50% эссенции за каждое перерождение
	gemsPerRebirth = 10, -- награда: 10 💎 × номер перерождения
}

function Config.RebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.baseCost * Config.Rebirth.growth ^ rebirths)
end

function Config.RebirthMultiplier(rebirths: number): number
	return 1 + Config.Rebirth.multiplierPerRebirth * rebirths
end

---------------------------------------------------------------------
-- Ежедневная награда
---------------------------------------------------------------------
Config.Daily = {
	cooldown = 20 * 3600, -- можно забирать раз в 20 часов
	streakWindow = 48 * 3600, -- если не зайти за 48 часов — серия сбрасывается
	maxStreak = 7,
	baseReward = 250,
}

function Config.NextDailyStreak(lastDaily: number, streak: number, now: number): number
	if lastDaily > 0 and now - lastDaily <= Config.Daily.streakWindow then
		return math.min(streak + 1, Config.Daily.maxStreak)
	end
	return 1
end

function Config.DailyReward(streak: number, unlockedZone: number, rebirths: number): number
	local zone = Config.Zones[unlockedZone]
	return math.floor(Config.Daily.baseReward * streak * zone.shadowValue * Config.RebirthMultiplier(rebirths))
end

---------------------------------------------------------------------
-- Задания (награда — кристаллы 💎)
---------------------------------------------------------------------
-- stat: kills, golden, bosses, eggs, crits — из data.stats; level и maxZone — из data.
Config.Quests = {
	{ id = "kills", icon = "👻", name = "Ловец теней", stat = "kills", text = "Поймать %s теней",
		goals = { 25, 100, 500, 2000, 10000, 50000 }, rewards = { 2, 5, 10, 20, 40, 80 } },
	{ id = "golden", icon = "✨", name = "Золотая лихорадка", stat = "golden", text = "Поймать %s золотых теней",
		goals = { 1, 10, 50, 200 }, rewards = { 3, 8, 20, 50 } },
	{ id = "bosses", icon = "⚔️", name = "Гроза Хранителей", stat = "bosses", text = "Победить %s Хранителей",
		goals = { 1, 5, 20, 50 }, rewards = { 5, 15, 40, 80 } },
	{ id = "eggs", icon = "🥚", name = "Заводчик", stat = "eggs", text = "Открыть %s яиц",
		goals = { 1, 10, 50, 200 }, rewards = { 2, 8, 20, 50 } },
	{ id = "crits", icon = "🎯", name = "Точный удар", stat = "crits", text = "Нанести %s критов",
		goals = { 50, 500, 5000, 25000 }, rewards = { 2, 8, 20, 40 } },
	{ id = "level", icon = "⭐", name = "Опыт тьмы", stat = "level", text = "Достичь %s уровня",
		goals = { 5, 10, 20, 35, 50 }, rewards = { 3, 8, 15, 30, 60 } },
	{ id = "zones", icon = "🗺️", name = "Исследователь", stat = "maxZone", text = "Открыть зону %s",
		goals = { 2, 3, 4, 5 }, rewards = { 5, 10, 25, 50 } },
}

function Config.QuestStat(data, stat: string): number
	if stat == "level" then
		return data.level
	elseif stat == "maxZone" then
		return data.maxZone
	end
	return data.stats[stat] or 0
end

function Config.FindQuest(id: string)
	for _, quest in Config.Quests do
		if quest.id == id then
			return quest
		end
	end
	return nil
end

-- Можно ли забрать награду за текущий этап задания.
function Config.QuestReady(data, quest): boolean
	local stage = (data.quests[quest.id] or 0) + 1
	local goal = quest.goals[stage]
	return goal ~= nil and Config.QuestStat(data, quest.stat) >= goal
end

---------------------------------------------------------------------
-- Доход, пока игрока не было
---------------------------------------------------------------------
Config.Offline = {
	minSeconds = 120,
	maxSeconds = 8 * 3600,
	efficiency = 0.5, -- офлайн духи собирают в 2 раза медленнее
}

---------------------------------------------------------------------
-- Буст за кристаллы
---------------------------------------------------------------------
Config.GemBoost = {
	price = 10,
	duration = 5 * 60,
}

---------------------------------------------------------------------
-- Монетизация
---------------------------------------------------------------------
-- 1. Создайте Game Passes и Developer Products в Creator Dashboard
--    (create.roblox.com → ваша игра → Monetization).
-- 2. Впишите их ID вместо 0. Пока ID = 0, кнопка в магазине неактивна.
-- price — только запасной текст для кнопки; настоящая цена берётся из Roblox.

Config.GamePasses = {
	DoubleEssence = {
		id = 0,
		icon = "✖️",
		name = "x2 Эссенция",
		description = "Навсегда удваивает всю эссенцию",
		price = 199,
	},
	AutoCatch = {
		id = 0,
		icon = "🤖",
		name = "Авто-ловля",
		description = "Фонарь сам бьёт ближайшую тень",
		price = 249,
	},
	PetSlot = {
		id = 0,
		icon = "🐾",
		name = "+1 слот питомца",
		description = "4 питомца вместо 3",
		price = 149,
	},
	VIP = {
		id = 0,
		icon = "👑",
		name = "Теневой VIP",
		description = "+50% эссенции и +4 к скорости",
		price = 299,
	},
}
Config.GamePassOrder = { "DoubleEssence", "AutoCatch", "PetSlot", "VIP" }

-- kind = "essence": amount × награда тени лучшей открытой зоны × множитель перерождений
-- kind = "boost": x2 эссенция на duration секунд (время складывается)
-- kind = "gems": amount кристаллов
Config.Products = {
	Boost = {
		id = 0,
		icon = "⚡",
		kind = "boost",
		name = "Буст x2 на 15 минут",
		duration = 15 * 60,
		price = 49,
	},
	Gems = {
		id = 0,
		icon = "💎",
		kind = "gems",
		name = "Мешочек кристаллов",
		amount = 50,
		price = 99,
	},
	EssenceMedium = {
		id = 0,
		icon = "🧪",
		kind = "essence",
		name = "Сосуд эссенции",
		amount = 5000,
		price = 99,
	},
	EssenceLarge = {
		id = 0,
		icon = "📦",
		kind = "essence",
		name = "Сундук эссенции",
		amount = 50000,
		price = 399,
	},
}
Config.ProductOrder = { "Boost", "Gems", "EssenceMedium", "EssenceLarge" }

function Config.EssencePackAmount(product, unlockedZone: number, rebirths: number): number
	local zone = Config.Zones[unlockedZone]
	return math.floor(product.amount * zone.shadowValue * Config.RebirthMultiplier(rebirths))
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Красивое отображение чисел и времени.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(text: string): string
	if string.find(text, "%.") then
		text = (string.gsub(text, "0+$", ""))
		text = (string.gsub(text, "%.$", ""))
	end
	return text
end

-- 1234 -> "1.23K", 5600000 -> "5.6M"
function Format.Number(value: number): string
	value = math.floor(value or 0)
	if math.abs(value) < 1000 then
		return tostring(value)
	end

	local index = 1
	local scaled = value
	while math.abs(scaled) >= 1000 and index < #SUFFIXES do
		scaled /= 1000
		index += 1
	end

	local text
	if math.abs(scaled) >= 100 then
		text = string.format("%.0f", scaled)
	elseif math.abs(scaled) >= 10 then
		text = string.format("%.1f", scaled)
	else
		text = string.format("%.2f", scaled)
	end
	return trimZeros(text) .. SUFFIXES[index]
end

-- 2.5 -> "x2.5"
function Format.Multiplier(value: number): string
	return "x" .. trimZeros(string.format("%.2f", value))
end

-- 3725 -> "1:02:05", 125 -> "2:05"
function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

return Format
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000000D"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Загрузка, хранение и сохранение данных игроков (DataStore).
-- Сервер — единственный источник правды: клиент только получает снимки.

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(script.Parent.Remotes)

local DataService = {}

local TEMPLATE = {
	essence = 0,
	totalEssence = 0,
	gems = 0,
	rebirths = 0,
	level = 1,
	xp = 0,
	upgrades = {
		power = 0,
		crit = 0,
		critDamage = 0,
		greed = 0,
		luck = 0,
		spirit = 0,
		speed = 0,
	},
	unlockedZone = 1,
	maxZone = 1, -- самая дальняя зона за всё время (для заданий)
	pets = {}, -- { { uid, rarity, kind, tier } }
	equipped = {}, -- uid надетых питомцев
	quests = {}, -- [questId] = сколько этапов пройдено
	stats = {
		kills = 0,
		golden = 0,
		bosses = 0,
		eggs = 0,
		crits = 0,
		taps = 0,
		time = 0,
	},
	lastDaily = 0,
	dailyStreak = 0,
	boostEndsAt = 0,
	lastSeen = 0,
	purchases = {}, -- [PurchaseId] = true — защита от двойной выдачи покупок
	purchaseLog = {}, -- порядок покупок, чтобы хранить только последние
}

local MAX_PURCHASE_HISTORY = 50

local store: DataStore? = nil
local sessions = {} -- [Player] = session
local loadedCallbacks = {}

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in value do
		copy[key] = deepCopy(inner)
	end
	return copy
end

-- Добавляет недостающие поля (когда в игре появляются новые данные).
local function reconcile(data, template)
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function retry(callback, attempts: number)
	local lastError
	for attempt = 1, attempts do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(string.format("[DataService] попытка %d/%d не удалась: %s", attempt, attempts, tostring(result)))
		if attempt < attempts then
			task.wait(2 ^ attempt)
		end
	end
	return false, lastError
end

local function createLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local essence = Instance.new("StringValue")
	essence.Name = "Эссенция"
	essence.Value = "0"
	essence.Parent = leaderstats

	local level = Instance.new("IntValue")
	level.Name = "Уровень"
	level.Value = 1
	level.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Перерождения"
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local essence = leaderstats:FindFirstChild("Эссенция")
	local rebirths = leaderstats:FindFirstChild("Перерождения")
	if essence then
		essence.Value = Format.Number(data.essence)
	end
	if rebirths then
		rebirths.Value = data.rebirths
	end
	local level = leaderstats:FindFirstChild("Уровень")
	if level then
		level.Value = data.level
	end
end

local function loadPlayer(player: Player)
	local data
	local canSave = false

	if store then
		local ok, result = retry(function()
			return store:GetAsync(keyFor(player))
		end, 3)

		if ok then
			data = if type(result) == "table" then result else deepCopy(TEMPLATE)
			canSave = true
		elseif RunService:IsStudio() then
			warn("[DataService] DataStore недоступен в Studio — прогресс не будет сохраняться. "
				.. "Включите Game Settings → Security → Enable Studio Access to API Services.")
			data = deepCopy(TEMPLATE)
		else
			-- Не пускаем в игру без данных, иначе можно затереть настоящий прогресс.
			player:Kick("Не удалось загрузить ваши данные. Пожалуйста, перезайдите.")
			return
		end
	else
		data = deepCopy(TEMPLATE)
	end

	reconcile(data, TEMPLATE)
	data.unlockedZone = math.clamp(data.unlockedZone, 1, #Config.Zones)
	data.maxZone = math.max(data.maxZone, data.unlockedZone)

	if player.Parent ~= Players then
		return -- игрок вышел, пока грузились данные
	end

	sessions[player] = {
		data = data,
		canSave = canSave,
		passes = {}, -- заполняет MonetizationService
		dirty = false,
		lastClick = 0,
		lastAction = 0,
		lastNotice = 0,
		combo = 0,
		lastComboHit = 0,
	}

	createLeaderstats(player)
	DataService.Push(player)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player)
	end
end

-- Возвращает сессию игрока или nil, если данные ещё не загружены.
function DataService.Get(player: Player)
	return sessions[player]
end

-- Вызывает callback(player), когда данные игрока загружены.
function DataService.OnPlayerLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

-- Отправляет клиенту свежий снимок данных прямо сейчас.
function DataService.Push(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	session.dirty = false
	local data = session.data
	local snapshot = { passes = session.passes }
	for key, value in data do
		if key ~= "purchases" and key ~= "purchaseLog" then
			snapshot[key] = value
		end
	end
	Remotes.DataChanged:FireClient(player, snapshot)
	updateLeaderstats(player, data)
end

-- Помечает данные изменёнными: снимок уйдёт клиенту в ближайшие доли секунды.
-- Нужно для частых событий (клики), чтобы не спамить сетью.
function DataService.MarkDirty(player: Player)
	local session = sessions[player]
	if session then
		session.dirty = true
	end
end

-- Отмечает покупку выданной и хранит только последние N идентификаторов.
function DataService.RecordPurchase(player: Player, purchaseId: string)
	local session = sessions[player]
	if not session then
		return
	end
	local data = session.data
	data.purchases[purchaseId] = true
	table.insert(data.purchaseLog, purchaseId)
	while #data.purchaseLog > MAX_PURCHASE_HISTORY do
		local oldest = table.remove(data.purchaseLog, 1)
		data.purchases[oldest] = nil
	end
end

function DataService.Save(player: Player): boolean
	local session = sessions[player]
	if not session or not session.canSave or not store then
		return false
	end
	session.data.lastSeen = os.time()
	local snapshot = deepCopy(session.data)
	local ok = retry(function()
		store:SetAsync(keyFor(player), snapshot, { player.UserId })
	end, 3)
	return ok
end

function DataService.Start()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore недоступен: " .. tostring(result))
	end

	Players.PlayerAdded:Connect(loadPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPlayer, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		if sessions[player] then
			DataService.Save(player)
			sessions[player] = nil
		end
	end)

	-- Автосохранение
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in sessions do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	-- Отправка «грязных» снимков клиентам
	task.spawn(function()
		while true do
			task.wait(0.25)
			for player, session in sessions do
				if session.dirty then
					DataService.Push(player)
				end
			end
		end
	end)

	-- Сохранение всех при выключении сервера
	game:BindToClose(function()
		local pending = 0
		for player in sessions do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">GameService</string><ProtectedString name="Source"><![CDATA[-- Игровая логика: награды, уровень, криты, комбо, характеристики, зоны,
-- перерождение, ежедневная награда, задания и доход офлайн.
-- Все действия игрока приходят сюда через Remotes.Action и проверяются на сервере.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)

local GameService = {}

local ACTION_COOLDOWN = 0.12
local actions = {}

---------------------------------------------------------------------
-- Общие функции
---------------------------------------------------------------------

function GameService.Notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

-- Визуальный эффект у клиента (см. src/client/Main.client.luau → Fx).
function GameService.Fx(player: Player, kind: string, ...)
	Remotes.Fx:FireClient(player, kind, ...)
end

function GameService.Multiplier(player: Player): number
	local session = DataService.Get(player)
	if not session then
		return 1
	end
	return Config.EssenceMultiplier(session.data, session.passes, os.time())
end

-- Начисляет эссенцию. pushNow = true — сразу обновить интерфейс.
function GameService.AddEssence(player: Player, amount: number, pushNow: boolean?): number
	local session = DataService.Get(player)
	if not session then
		return 0
	end
	amount = math.max(0, math.floor(amount))
	session.data.essence += amount
	session.data.totalEssence += amount
	if pushNow then
		DataService.Push(player)
	else
		DataService.MarkDirty(player)
	end
	return amount
end

function GameService.AddGems(player: Player, amount: number)
	local session = DataService.Get(player)
	if session and amount > 0 then
		session.data.gems += math.floor(amount)
		DataService.MarkDirty(player)
	end
end

function GameService.AddXp(player: Player, amount: number)
	local session = DataService.Get(player)
	if not session then
		return
	end
	local data = session.data
	data.xp += amount
	local leveled = false
	while data.xp >= Config.XpNeeded(data.level) do
		data.xp -= Config.XpNeeded(data.level)
		data.level += 1
		leveled = true
	end
	if leveled then
		GameService.Notify(player, "⭐ Уровень " .. data.level .. "! Урон и эссенция выросли", "gold")
		GameService.Fx(player, "levelUp", data.level)
		DataService.Push(player)
	else
		DataService.MarkDirty(player)
	end
end

-- Урон удара игрока с учётом крита. Возвращает урон и был ли крит.
function GameService.RollTapDamage(session): (number, boolean)
	local data = session.data
	local damage = Config.TapDamage(data)
	if math.random() < Config.CritChance(data.upgrades.crit) then
		data.stats.crits += 1
		return damage * Config.CritMultiplier(data.upgrades.critDamage), true
	end
	return damage, false
end

-- Учитывает удар в комбо. Возвращает текущее комбо.
function GameService.RegisterCombo(session): number
	local now = os.clock()
	if now - session.lastComboHit <= Config.Combo.window then
		session.combo += 1
	else
		session.combo = 1
	end
	session.lastComboHit = now
	return session.combo
end

-- Награда за пойманную тень. kind: "normal", "gold" или "boss".
-- combo = 0 для ударов авто-ловли и духов.
-- Возвращает: эссенция, кристаллы, была ли счастливая ловля.
function GameService.RewardKill(player: Player, zoneIndex: number, kind: string, combo: number): (number, number, boolean)
	local session = DataService.Get(player)
	if not session then
		return 0, 0, false
	end
	local data = session.data
	local zone = Config.Zones[zoneIndex]

	local base = zone.shadowValue
	local gems = 0
	local xp = zoneIndex
	local lucky = false

	if kind == "gold" then
		base *= Config.Golden.rewardMultiplier
		gems = Config.Golden.gems
		xp *= Config.Golden.xpMultiplier
		data.stats.golden += 1
	elseif kind == "boss" then
		base *= Config.Boss.rewardMultiplier
		gems = Config.Boss.gemsPerZone * zoneIndex
		xp *= Config.Boss.xpMultiplier
		data.stats.bosses += 1
	elseif math.random() < Config.LuckyChance(data.upgrades.luck) then
		base *= Config.Golden.rewardMultiplier
		gems = Config.Golden.gems
		xp *= Config.Golden.xpMultiplier
		data.stats.golden += 1
		lucky = true
	end

	data.stats.kills += 1
	local amount = GameService.AddEssence(
		player,
		math.max(1, base * GameService.Multiplier(player) * Config.ComboMultiplier(combo))
	)
	GameService.AddGems(player, gems)
	GameService.AddXp(player, xp)
	return amount, gems, lucky
end

function GameService.ApplySpeed(player: Player)
	local session = DataService.Get(player)
	local character = player.Character
	if not session or not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = Config.WalkSpeed(session.data.upgrades.speed, session.passes.VIP == true)
	end
end

-- Доход, пока игрока не было. Вызывается после проверки Game Pass'ов.
function GameService.GrantOfflineEarnings(player: Player)
	local session = DataService.Get(player)
	if not session or session.offlineGranted then
		return
	end
	session.offlineGranted = true
	local data = session.data
	if data.lastSeen <= 0 then
		return
	end
	local away = math.min(Config.Offline.maxSeconds, os.time() - data.lastSeen)
	if away < Config.Offline.minSeconds then
		return
	end
	local zone = Config.Zones[data.unlockedZone]
	local dps = Config.SpiritDamage(data)
	if session.passes.AutoCatch then
		dps += Config.TapDamage(data) / Config.AutoCatchInterval
	end
	if dps <= 0 then
		return
	end
	local killsPerSecond = math.min(dps / zone.shadowHp, 4)
	local amount = killsPerSecond * zone.shadowValue * GameService.Multiplier(player) * Config.Offline.efficiency * away
	amount = GameService.AddEssence(player, amount, true)
	if amount > 0 then
		GameService.Fx(player, "offline", amount, away)
	end
end

-- Регистрирует действие, которое клиент может вызвать: Action:FireServer(name, arg)
function GameService.RegisterAction(name: string, handler)
	actions[name] = handler
end

---------------------------------------------------------------------
-- Действия
---------------------------------------------------------------------

GameService.RegisterAction("sync", function(player)
	DataService.Push(player)
end)

-- amount: 1, 10 или 0 (= максимум, сколько хватит эссенции)
GameService.RegisterAction("buyUpgrade", function(player, session, id, amount)
	local def = if type(id) == "string" then Config.Upgrades[id] else nil
	if not def then
		return
	end
	if amount ~= 1 and amount ~= 10 and amount ~= 0 then
		amount = 1
	end
	local wanted = if amount == 0 then math.huge else amount

	local data = session.data
	local level = data.upgrades[id]
	if level >= def.maxLevel then
		return GameService.Notify(player, "Это улучшение уже на максимуме", "bad")
	end

	local bought, total = 0, 0
	while bought < wanted and level + bought < def.maxLevel do
		local cost = Config.UpgradeCost(id, level + bought)
		if data.essence < total + cost then
			break
		end
		total += cost
		bought += 1
	end
	if bought == 0 then
		return GameService.Notify(player, "Не хватает эссенции", "bad")
	end

	data.essence -= total
	data.upgrades[id] = level + bought
	if id == "speed" then
		GameService.ApplySpeed(player)
	end
	DataService.Push(player)
end)

GameService.RegisterAction("buyZone", function(player, session)
	local data = session.data
	local nextIndex = data.unlockedZone + 1
	local zone = Config.Zones[nextIndex]
	if not zone then
		return GameService.Notify(player, "Все зоны уже открыты!", "info")
	end
	if data.essence < zone.price then
		return GameService.Notify(player, "Не хватает эссенции", "bad")
	end
	data.essence -= zone.price
	data.unlockedZone = nextIndex
	data.maxZone = math.max(data.maxZone, nextIndex)
	DataService.Push(player)
	GameService.Notify(player, "🗺 Открыта зона «" .. zone.name .. "»!", "good")
end)

GameService.RegisterAction("rebirth", function(player, session)
	local data = session.data
	local cost = Config.RebirthCost(data.rebirths)
	if data.essence < cost then
		return GameService.Notify(player, "Для перерождения нужно " .. Format.Number(cost) .. " эссенции", "bad")
	end
	data.rebirths += 1
	data.essence = 0
	data.unlockedZone = 1
	for id in data.upgrades do
		data.upgrades[id] = 0
	end
	-- Уровень, питомцы, кристаллы и задания сохраняются.
	local gems = Config.Rebirth.gemsPerRebirth * data.rebirths
	data.gems += gems
	DataService.Push(player)
	player:LoadCharacter() -- возвращаем на старт
	GameService.Fx(player, "rebirth", data.rebirths, gems)
end)

GameService.RegisterAction("claimDaily", function(player, session)
	local data = session.data
	local now = os.time()
	local remaining = Config.Daily.cooldown - (now - data.lastDaily)
	if data.lastDaily > 0 and remaining > 0 then
		return GameService.Notify(player, "Награда будет доступна через " .. Format.Duration(remaining), "bad")
	end
	local streak = Config.NextDailyStreak(data.lastDaily, data.dailyStreak, now)
	local reward = Config.DailyReward(streak, data.unlockedZone, data.rebirths)
	data.dailyStreak = streak
	data.lastDaily = now
	data.gems += streak
	GameService.AddEssence(player, reward, true)
	GameService.Fx(player, "daily", streak, reward, streak)
end)

GameService.RegisterAction("claimQuest", function(player, session, questId)
	local quest = if type(questId) == "string" then Config.FindQuest(questId) else nil
	if not quest or not Config.QuestReady(session.data, quest) then
		return
	end
	local stage = (session.data.quests[quest.id] or 0) + 1
	local reward = quest.rewards[stage]
	session.data.quests[quest.id] = stage
	session.data.gems += reward
	DataService.Push(player)
	GameService.Notify(player, string.format("📜 %s: +%d 💎", quest.name, reward), "gem")
end)

GameService.RegisterAction("gemBoost", function(player, session)
	local data = session.data
	if data.gems < Config.GemBoost.price then
		return GameService.Notify(player, "Не хватает кристаллов 💎", "bad")
	end
	data.gems -= Config.GemBoost.price
	data.boostEndsAt = math.max(data.boostEndsAt, os.time()) + Config.GemBoost.duration
	DataService.Push(player)
	GameService.Notify(player, "⚡ Буст x2 на 5 минут!", "good")
end)

---------------------------------------------------------------------

function GameService.Init()
	Remotes.Action.OnServerEvent:Connect(function(player, name, arg1, arg2)
		if type(name) ~= "string" then
			return
		end
		local handler = actions[name]
		local session = DataService.Get(player)
		if not handler or not session then
			return
		end
		local now = os.clock()
		if now - session.lastAction < ACTION_COOLDOWN then
			return
		end
		session.lastAction = now

		local ok, err = pcall(handler, player, session, arg1, arg2)
		if not ok then
			warn("[GameService] ошибка в действии " .. name .. ": " .. tostring(err))
		end
	end)

	DataService.OnPlayerLoaded(function(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			GameService.ApplySpeed(player)
		end)
		GameService.ApplySpeed(player)
	end)

	-- Время в игре (для профиля)
	task.spawn(function()
		while true do
			task.wait(10)
			for _, player in Players:GetPlayers() do
				local session = DataService.Get(player)
				if session then
					session.data.stats.time += 10
				end
			end
		end
	end)
end

return GameService
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX00000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Точка входа сервера. Порядок важен: сначала подписки, потом загрузка игроков.

local Server = script.Parent

local DataService = require(Server.DataService)
local GameService = require(Server.GameService)
local MonetizationService = require(Server.MonetizationService)
local PetService = require(Server.PetService)
local WorldService = require(Server.WorldService)

-- Купили «+1 слот питомца» — перерисовываем питомцев.
MonetizationService.SetPassesChangedCallback(PetService.Refresh)

GameService.Init()
MonetizationService.Init()
PetService.Init()
WorldService.Init()
DataService.Start()
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[-- Game Passes и Developer Products.
-- ID задаются в ReplicatedStorage.Shared.Config.

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)

local MonetizationService = {}

-- Вызывается, когда меняются пропуска (например, +1 слот питомца).
-- Задаётся из Main через MonetizationService.SetPassesChangedCallback.
local onPassesChanged = function(_player: Player) end

function MonetizationService.SetPassesChangedCallback(callback)
	onPassesChanged = callback
end

local passKeyById = {} -- [gamePassId] = "DoubleEssence"
local productById = {} -- [productId] = def

for key, def in Config.GamePasses do
	if def.id ~= 0 then
		passKeyById[def.id] = key
	end
end
for _, def in Config.Products do
	if def.id ~= 0 then
		productById[def.id] = def
	end
end

local function grantPass(player: Player, key: string)
	local session = DataService.Get(player)
	if not session then
		return
	end
	session.passes[key] = true
	GameService.ApplySpeed(player)
	DataService.Push(player)
	onPassesChanged(player)
end

local function checkPasses(player: Player)
	local session = DataService.Get(player)
	if not session then
		return
	end
	for key, def in Config.GamePasses do
		if def.id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.id)
			end)
			if ok and owns then
				session.passes[key] = true
			end
		end
	end
	GameService.ApplySpeed(player)
	DataService.Push(player)
	onPassesChanged(player)
	GameService.GrantOfflineEarnings(player)
end

-- Выдача Developer Products по типу.
local productHandlers = {
	essence = function(player: Player, def)
		local data = DataService.Get(player).data
		local amount = Config.EssencePackAmount(def, data.unlockedZone, data.rebirths)
		GameService.AddEssence(player, amount, true)
		GameService.Notify(player, "Спасибо за покупку! +" .. Format.Number(amount) .. " эссенции", "good")
	end,

	gems = function(player: Player, def)
		GameService.AddGems(player, def.amount)
		DataService.Push(player)
		GameService.Notify(player, "Спасибо за покупку! +" .. def.amount .. " 💎", "gem")
	end,

	boost = function(player: Player, def)
		local data = DataService.Get(player).data
		data.boostEndsAt = math.max(data.boostEndsAt, os.time()) + def.duration
		DataService.Push(player)
		GameService.Notify(player, "Буст x2 активирован!", "good")
	end,
}

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local session = DataService.Get(player)
	if not session then
		-- Данные ещё не загружены — Roblox повторит попытку позже.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Эта покупка уже выдана (повторный вызов) — не выдаём второй раз.
	if session.data.purchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local def = productById[receipt.ProductId]
	local handler = def and productHandlers[def.kind]
	if not handler then
		warn("[Monetization] неизвестный продукт: " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(handler, player, def)
	if not ok then
		warn("[Monetization] ошибка выдачи: " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	DataService.RecordPurchase(player, receipt.PurchaseId)

	-- Подтверждаем покупку только после сохранения — иначе при сбое игрок потеряет товар.
	if session.canSave and not DataService.Save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	DataService.OnPlayerLoaded(checkPasses)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = passKeyById[passId]
		if purchased and key then
			grantPass(player, key)
			GameService.Notify(player, "Куплено: " .. Config.GamePasses[key].name .. "!", "good")
		end
	end)

	MarketplaceService.ProcessReceipt = processReceipt
end

return MonetizationService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[-- Питомцы: яйца, надевание/снятие, удаление и модели, которые летают за игроком.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)

local PetService = {}

local petModels = {} -- [Player] = { BasePart }

---------------------------------------------------------------------
-- Модели питомцев в мире
---------------------------------------------------------------------

local function clearModels(player: Player)
	for _, part in petModels[player] or {} do
		part:Destroy()
	end
	petModels[player] = {}
end

-- Позиция питомца относительно игрока: полукругом за спиной.
local function slotOffset(index: number, count: number): Vector3
	local spread = (index - (count + 1) / 2) * 3.2
	return Vector3.new(spread, 1.5 + (index % 2) * 0.8, 4.5)
end

local function createPetPart(pet, root: BasePart, index: number, count: number): BasePart
	local info = Config.PetInfo(pet)
	local rarity = Config.Rarities[pet.rarity]

	local part = Instance.new("Part")
	part.Name = "Pet_" .. info.name
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1.4, 1.4, 1.4)
	part.Material = Enum.Material.Neon
	part.Color = rarity.color
	part.Transparency = 0.35
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CFrame = root.CFrame * CFrame.new(slotOffset(index, count))

	local light = Instance.new("PointLight")
	light.Color = rarity.color
	light.Range = 8
	light.Brightness = 1.5
	light.Parent = part

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(3, 3)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 120
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Text = info.emoji
	label.Parent = billboard

	-- Физическое следование за игроком (плавно и без нагрузки на сервер)
	local petAttachment = Instance.new("Attachment")
	petAttachment.Parent = part

	local slotAttachment = Instance.new("Attachment")
	slotAttachment.Name = "PetSlot" .. index
	slotAttachment.Position = slotOffset(index, count)
	slotAttachment.Parent = root

	local align = Instance.new("AlignPosition")
	align.Attachment0 = petAttachment
	align.Attachment1 = slotAttachment
	align.Responsiveness = 18
	align.MaxForce = 1e6
	align.Parent = part

	local orient = Instance.new("AlignOrientation")
	orient.Attachment0 = petAttachment
	orient.Attachment1 = slotAttachment
	orient.Responsiveness = 18
	orient.MaxTorque = 1e6
	orient.Parent = part

	-- При удалении питомца убираем и точку крепления на персонаже
	part.Destroying:Connect(function()
		slotAttachment:Destroy()
	end)

	return part
end

function PetService.Refresh(player: Player)
	clearModels(player)
	local session = DataService.Get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not session or not root then
		return
	end

	local pets = {}
	for _, uid in session.data.equipped do
		local pet = Config.FindPet(session.data, uid)
		if pet then
			table.insert(pets, pet)
		end
	end

	for index, pet in pets do
		local part = createPetPart(pet, root, index, #pets)
		part.Parent = character
		pcall(function()
			part:SetNetworkOwner(player)
		end)
		table.insert(petModels[player], part)
	end
end

-- Части питомцев игрока (для выстрелов духа-помощника).
function PetService.GetPetParts(player: Player): { BasePart }
	return petModels[player] or {}
end

---------------------------------------------------------------------
-- Яйца
---------------------------------------------------------------------

local function rollRarity(odds): string
	local roll = math.random()
	for _, rarity in Config.RarityOrder do
		if roll < odds[rarity] then
			return rarity
		end
		roll -= odds[rarity]
	end
	return "common"
end

-- tier: номер зоны яйца (1..5) или "gold" — Золотое яйцо за кристаллы.
GameService.RegisterAction("openEgg", function(player, session, tier)
	local data = session.data
	if #data.pets >= Config.Pets.inventory then
		return GameService.Notify(player, "Инвентарь полон — удалите слабых питомцев", "bad")
	end

	local odds = Config.Pets.eggOdds
	if tier == "gold" then
		if data.gems < Config.Pets.goldEggPrice then
			return GameService.Notify(player, "Не хватает кристаллов 💎", "bad")
		end
		data.gems -= Config.Pets.goldEggPrice
		odds = Config.Pets.goldEggOdds
		tier = data.unlockedZone
	else
		if type(tier) ~= "number" or tier % 1 ~= 0 or tier < 1 or tier > data.unlockedZone then
			return
		end
		local price = Config.Zones[tier].eggPrice
		if data.essence < price then
			return GameService.Notify(player, "Не хватает эссенции", "bad")
		end
		data.essence -= price
	end

	local rarity = rollRarity(odds)
	local pet = {
		uid = HttpService:GenerateGUID(false),
		rarity = rarity,
		kind = math.random(1, #Config.PetPool[rarity]),
		tier = tier,
	}
	table.insert(data.pets, pet)
	data.stats.eggs += 1

	local autoEquipped = false
	if #data.equipped < Config.PetSlots(session.passes) then
		table.insert(data.equipped, pet.uid)
		autoEquipped = true
		PetService.Refresh(player)
	end

	DataService.Push(player)
	GameService.Fx(player, "hatch", pet, autoEquipped)
end)

---------------------------------------------------------------------
-- Управление питомцами
---------------------------------------------------------------------

GameService.RegisterAction("toggleEquip", function(player, session, uid)
	local data = session.data
	if type(uid) ~= "string" or not Config.FindPet(data, uid) then
		return
	end
	local index = table.find(data.equipped, uid)
	if index then
		table.remove(data.equipped, index)
	elseif #data.equipped < Config.PetSlots(session.passes) then
		table.insert(data.equipped, uid)
	else
		return GameService.Notify(player, "Все слоты заняты — снимите одного питомца", "bad")
	end
	PetService.Refresh(player)
	DataService.Push(player)
end)

GameService.RegisterAction("equipBest", function(player, session)
	local data = session.data
	local sorted = table.clone(data.pets)
	table.sort(sorted, function(a, b)
		return Config.PetPower(a) > Config.PetPower(b)
	end)
	data.equipped = {}
	for i = 1, math.min(#sorted, Config.PetSlots(session.passes)) do
		table.insert(data.equipped, sorted[i].uid)
	end
	PetService.Refresh(player)
	DataService.Push(player)
	GameService.Notify(player, "Надеты лучшие питомцы", "good")
end)

GameService.RegisterAction("deletePet", function(player, session, uid)
	local data = session.data
	if type(uid) ~= "string" then
		return
	end
	if table.find(data.equipped, uid) then
		return GameService.Notify(player, "Сначала снимите питомца", "bad")
	end
	for i, pet in data.pets do
		if pet.uid == uid then
			table.remove(data.pets, i)
			break
		end
	end
	DataService.Push(player)
end)

---------------------------------------------------------------------

function PetService.Init()
	DataService.OnPlayerLoaded(function(player)
		petModels[player] = {}
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			PetService.Refresh(player)
		end)
		PetService.Refresh(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearModels(player)
		petModels[player] = nil
	end)
end

return PetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Создаёт RemoteEvent'ы для связи сервера и клиента.
-- Модуль кэшируется, поэтому объекты создаются один раз.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function make(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

local Remotes = {
	DataChanged = make("DataChanged"), -- сервер → клиент: снимок данных игрока
	Notify = make("Notify"), -- сервер → клиент: всплывающее сообщение
	Action = make("Action"), -- клиент → сервер: действие игрока (купить, переродиться...)
	Fx = make("Fx"), -- сервер → клиент: эффекты (урон, награда, вылупление, Хранитель...)
}

folder.Parent = ReplicatedStorage

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- Генерирует мир (зоны, мосты, освещение, частицы) и управляет тенями:
-- обычными, золотыми и Хранителями зон.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local PetService = require(script.Parent.PetService)

local WorldService = {}

local ZONE_SIZE = Config.World.ZoneSize
local ZONE_GAP = Config.World.ZoneGap

local rng = Random.new()
local worldFolder: Folder
local shadowsFolder: Folder
local shadowStates = {} -- [BasePart] = state
local zoneKills = {} -- [zoneIndex] = поймано теней (всеми игроками) до Хранителя
local bosses = {} -- [zoneIndex] = BasePart

local function zoneCenter(index: number): Vector3
	return Vector3.new((index - 1) * (ZONE_SIZE + ZONE_GAP), 0, 0)
end

-- Точка входа в зону (западный край) — сюда телепортируем игрока.
local function zoneEntrance(index: number): Vector3
	return zoneCenter(index) + Vector3.new(-ZONE_SIZE / 2 + 12, 4, 0)
end

local function clampToZone(index: number, position: Vector3): Vector3
	local center = zoneCenter(index)
	local half = ZONE_SIZE / 2 - 8
	return Vector3.new(
		math.clamp(position.X, center.X - half, center.X + half),
		position.Y,
		math.clamp(position.Z, center.Z - half, center.Z + half)
	)
end

local function randomPointInZone(index: number, height: number): Vector3
	local center = zoneCenter(index)
	local half = ZONE_SIZE / 2 - 10
	return center + Vector3.new(rng:NextNumber(-half, half), height, rng:NextNumber(-half, half))
end

-- Свойства, которые нужно ставить в строгом порядке (форма → размер → остальное → позиция).
local ORDERED_FIRST = { "Shape", "Size" }
local ORDERED_LAST = { "Position", "CFrame", "Parent" }
local SPECIAL = { Shape = true, Size = true, Position = true, CFrame = true, Parent = true }

local function makePart(props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for _, key in ORDERED_FIRST do
		if props[key] ~= nil then
			part[key] = props[key]
		end
	end
	for key, value in props do
		if not SPECIAL[key] then
			part[key] = value
		end
	end
	for _, key in ORDERED_LAST do
		if props[key] ~= nil then
			part[key] = props[key]
		end
	end
	return part
end

local function weld(part: BasePart, to: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = to
	constraint.Part1 = part
	constraint.Parent = part
end

---------------------------------------------------------------------
-- Карта
---------------------------------------------------------------------

local function applyLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.5
	Lighting.Ambient = Color3.fromRGB(70, 60, 100)
	Lighting.OutdoorAmbient = Color3.fromRGB(90, 80, 130)

	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.35
		atmosphere.Color = Color3.fromRGB(80, 70, 120)
		atmosphere.Decay = Color3.fromRGB(40, 30, 70)
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.8
		bloom.Size = 30
		bloom.Threshold = 0.9
		bloom.Parent = Lighting
	end
end

-- Частицы атмосферы зоны: светлячки, туман, искры, снег, искры Бездны.
local function addAmbient(index: number, zone, parent: Instance)
	local emitterPart = makePart({
		Name = "Ambient",
		Size = Vector3.new(ZONE_SIZE, 1, ZONE_SIZE),
		Position = zoneCenter(index) + Vector3.new(0, if zone.ambient == "snow" then 45 else 2, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = parent,
	})

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(zone.ambientColor)
	emitter.LightEmission = 1
	emitter.LockedToPart = false

	if zone.ambient == "fireflies" then
		emitter.Rate = 12
		emitter.Lifetime = NumberRange.new(4, 7)
		emitter.Speed = NumberRange.new(0.5, 2)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, 0.6, 0)
		emitter.Size = NumberSequence.new(0.35)
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0),
			NumberSequenceKeypoint.new(0.6, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif zone.ambient == "fog" then
		emitter.Rate = 6
		emitter.Lifetime = NumberRange.new(8, 12)
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.SpreadAngle = Vector2.new(180, 20)
		emitter.Size = NumberSequence.new(10, 18)
		emitter.LightEmission = 0.2
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 0.82),
			NumberSequenceKeypoint.new(1, 1),
		})
	elseif zone.ambient == "embers" then
		emitter.Rate = 25
		emitter.Lifetime = NumberRange.new(3, 6)
		emitter.Speed = NumberRange.new(3, 7)
		emitter.SpreadAngle = Vector2.new(25, 25)
		emitter.Acceleration = Vector3.new(0, 2, 0)
		emitter.Size = NumberSequence.new(0.25, 0)
		emitter.Transparency = NumberSequence.new(0, 1)
	elseif zone.ambient == "snow" then
		emitter.Rate = 60
		emitter.Lifetime = NumberRange.new(8, 10)
		emitter.Speed = NumberRange.new(3, 5)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.SpreadAngle = Vector2.new(15, 15)
		emitter.Size = NumberSequence.new(0.3)
		emitter.LightEmission = 0.3
		emitter.Transparency = NumberSequence.new(0.1, 0.6)
	else -- void
		emitter.Rate = 30
		emitter.Lifetime = NumberRange.new(3, 5)
		emitter.Speed = NumberRange.new(2, 6)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.RotSpeed = NumberRange.new(-90, 90)
		emitter.Acceleration = Vector3.new(0, 1.5, 0)
		emitter.Size = NumberSequence.new(0.4, 0)
		emitter.Transparency = NumberSequence.new(0, 1)
	end
	emitter.Parent = emitterPart
end

local function buildZone(index: number, zone)
	local model = Instance.new("Model")
	model.Name = string.format("Zone%d", index)

	local center = zoneCenter(index)

	makePart({
		Name = "Floor",
		Size = Vector3.new(ZONE_SIZE, 4, ZONE_SIZE),
		Position = center - Vector3.new(0, 2, 0),
		Color = zone.floorColor,
		Material = Enum.Material.Slate,
		Parent = model,
	})

	-- Мост к следующей зоне
	if index < #Config.Zones then
		makePart({
			Name = "Bridge",
			Size = Vector3.new(ZONE_GAP, 2, 16),
			Position = center + Vector3.new(ZONE_SIZE / 2 + ZONE_GAP / 2, -1, 0),
			Color = Color3.fromRGB(40, 35, 55),
			Material = Enum.Material.WoodPlanks,
			Parent = model,
		})
	end

	-- Декор: тёмные колонны со светящимися кристаллами
	for _ = 1, 8 do
		local height = rng:NextNumber(10, 26)
		local base = randomPointInZone(index, 0)
		makePart({
			Name = "Pillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, 3, 3),
			CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = zone.shadowColor,
			Material = Enum.Material.Basalt,
			Parent = model,
		})
		local crystal = makePart({
			Name = "Crystal",
			Size = Vector3.new(1.4, 3, 1.4),
			CFrame = CFrame.new(base + Vector3.new(0, height + 1.8, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), math.rad(15)),
			Color = zone.glowColor,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
		local light = Instance.new("PointLight")
		light.Color = zone.glowColor
		light.Range = 18
		light.Brightness = 2
		light.Parent = crystal
	end

	addAmbient(index, zone, model)

	-- Табличка с названием и ценой зоны
	local signAnchor = makePart({
		Name = "Sign",
		Size = Vector3.new(1, 1, 1),
		Position = zoneEntrance(index) + Vector3.new(0, 10, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(320, 80)
	billboard.MaxDistance = 220
	billboard.LightInfluence = 0
	billboard.Parent = signAnchor

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = zone.glowColor
	label.TextStrokeTransparency = 0.3
	label.Text = if zone.price > 0
		then string.format("%s\n🔒 %d эссенции", zone.name, zone.price)
		else zone.name
	label.Parent = billboard

	model.Parent = worldFolder
end

local function buildWorld()
	if Config.World.RemoveDefaultBaseplate then
		local baseplate = workspace:FindFirstChild("Baseplate")
		if baseplate then
			baseplate:Destroy()
		end
		for _, child in workspace:GetChildren() do
			if child:IsA("SpawnLocation") then
				child:Destroy()
			end
		end
	end

	if Config.World.ApplyLighting then
		applyLighting()
	end

	worldFolder = Instance.new("Folder")
	worldFolder.Name = "ShadowWorld"
	worldFolder.Parent = workspace

	for index, zone in Config.Zones do
		buildZone(index, zone)
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = zoneEntrance(1) - Vector3.new(0, 3.5, 0)
	spawn.Color = Color3.fromRGB(140, 90, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Duration = 0
	spawn.Parent = worldFolder

	shadowsFolder = Instance.new("Folder")
	shadowsFolder.Name = "Shadows"
	shadowsFolder.Parent = workspace
end

---------------------------------------------------------------------
-- Модель тени (призрак: тело, хвост, глаза, свечение)
---------------------------------------------------------------------

local function buildGhost(kind: string, zone, size: number, cframe: CFrame): BasePart
	local isGold = kind == "gold"
	local isBoss = kind == "boss"
	local glow = if isGold
		then Color3.fromRGB(255, 210, 80)
		elseif isBoss then Color3.fromRGB(255, 50, 80)
		else zone.glowColor
	local bodyColor = if isGold
		then Color3.fromRGB(255, 200, 60)
		elseif isBoss then Color3.fromRGB(40, 8, 20)
		else zone.shadowColor

	local body = makePart({
		Name = if isBoss then "Guardian" elseif isGold then "GoldenShadow" else "Shadow",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		CFrame = cframe,
		Color = bodyColor,
		Material = if isGold then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		CanCollide = false,
	})

	local tail = makePart({
		Name = "Tail",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size * 0.75, size * 0.75, size * 0.75),
		CFrame = body.CFrame * CFrame.new(0, -size * 0.45, size * 0.1),
		Color = bodyColor,
		Material = body.Material,
		Transparency = 0.25,
		CanCollide = false,
		Anchored = false,
		Massless = true,
		Parent = body,
	})
	weld(tail, body)

	-- Глаза смотрят вперёд (-Z)
	local eyeColor = if isBoss then Color3.fromRGB(255, 40, 60) elseif isGold then Color3.fromRGB(90, 50, 0) else glow
	for _, side in { -1, 1 } do
		local eye = makePart({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size * 0.18, size * 0.28, size * 0.12),
			CFrame = body.CFrame * CFrame.new(side * size * 0.2, size * 0.1, -size * 0.45),
			Color = eyeColor,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Anchored = false,
			Massless = true,
			Parent = body,
		})
		weld(eye, body)
	end

	-- Рога Хранителя
	if isBoss then
		for _, side in { -1, 1 } do
			local horn = makePart({
				Name = "Horn",
				Size = Vector3.new(size * 0.12, size * 0.5, size * 0.12),
				CFrame = body.CFrame * CFrame.new(side * size * 0.28, size * 0.55, 0) * CFrame.Angles(0, 0, -side * math.rad(25)),
				Color = Color3.fromRGB(20, 5, 10),
				Material = Enum.Material.Slate,
				CanCollide = false,
				Anchored = false,
				Massless = true,
				Parent = body,
			})
			weld(horn, body)
		end
	end

	local light = Instance.new("PointLight")
	light.Color = glow
	light.Range = if isBoss then 30 else 12
	light.Brightness = if isBoss then 4 else 2
	light.Parent = body

	-- Призрачный шлейф
	local wisps = Instance.new("ParticleEmitter")
	wisps.Color = ColorSequence.new(glow)
	wisps.LightEmission = 1
	wisps.Rate = if isBoss then 30 else 8
	wisps.Lifetime = NumberRange.new(0.6, 1.2)
	wisps.Speed = NumberRange.new(0.5, 1.5)
	wisps.SpreadAngle = Vector2.new(180, 180)
	wisps.Size = NumberSequence.new(size * 0.25, 0)
	wisps.Transparency = NumberSequence.new(0.4, 1)
	wisps.Parent = body

	if isGold then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 230, 120)
		sparkles.Parent = body
	end

	return body
end

local function buildHealthBar(part: BasePart, size: number, color: Color3)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Health"
	billboard.Size = UDim2.fromOffset(90, 10)
	billboard.StudsOffset = Vector3.new(0, size / 2 + 1.5, 0)
	billboard.MaxDistance = 70
	billboard.LightInfluence = 0
	billboard.Enabled = false -- показываем после первого удара
	billboard.Parent = part

	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
	back.BorderSizePixel = 0
	back.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = back

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	corner:Clone().Parent = fill

	return billboard, fill
end

---------------------------------------------------------------------
-- Тени: появление, движение, урон, смерть
---------------------------------------------------------------------

local spawnShadow -- объявлено заранее, чтобы использовать внутри killShadow

local function wander(part: BasePart, state)
	while state.alive and part.Parent do
		local range = if state.kind == "boss" then 12 else 18
		local target = clampToZone(
			state.zone,
			part.Position + Vector3.new(rng:NextNumber(-range, range), 0, rng:NextNumber(-range, range))
		)
		local speed = if state.kind == "gold" then 14 elseif state.kind == "boss" then 4 else 6
		local duration = math.max(0.5, (target - part.Position).Magnitude / speed)
		local lookAt = CFrame.lookAt(part.Position, Vector3.new(target.X, part.Position.Y, target.Z))
		part.CFrame = lookAt
		TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Sine), {
			CFrame = lookAt.Rotation + target,
		}):Play()
		task.wait(duration + (if state.kind == "gold" then 0.1 else rng:NextNumber(0.5, 2)))
	end
end

local function updateKillCounter(zoneIndex: number)
	shadowsFolder:SetAttribute("Kills" .. zoneIndex, zoneKills[zoneIndex] or 0)
end

local function killShadow(part: BasePart, state)
	state.alive = false
	shadowStates[part] = nil

	for _, child in part:GetDescendants() do
		if child:IsA("BasePart") then
			TweenService:Create(child, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		end
	end
	local tween = TweenService:Create(part, TweenInfo.new(0.3), { Size = part.Size * 1.8, Transparency = 1 })
	tween:Play()
	tween.Completed:Once(function()
		part:Destroy()
	end)

	if state.kind == "boss" then
		bosses[state.zone] = nil
	else
		task.delay(Config.ShadowRespawnTime, spawnShadow, state.zone, "auto")
	end
end

local function spawnBoss(zoneIndex: number)
	if bosses[zoneIndex] then
		return
	end
	local part = spawnShadow(zoneIndex, "boss")
	bosses[zoneIndex] = part

	-- Сообщаем игрокам, которые сейчас в этой зоне
	for _, player in Players:GetPlayers() do
		GameService.Fx(player, "boss", zoneIndex)
	end

	task.delay(Config.Boss.duration, function()
		local state = shadowStates[part]
		if state and state.alive then
			state.alive = false
			shadowStates[part] = nil
			bosses[zoneIndex] = nil
			zoneKills[zoneIndex] = Config.Boss.retryKills
			updateKillCounter(zoneIndex)
			for player in state.contributors do
				if player.Parent then
					GameService.Notify(player, "Хранитель ушёл… Прокачайтесь и попробуйте снова", "bad")
				end
			end
			part:Destroy()
		end
	end)
end

-- Удар по тени. source: "tap" (клик), "auto" (Game Pass) или "spirit" (дух-помощник).
function WorldService.Hit(player: Player, part: BasePart, source: string)
	local state = shadowStates[part]
	if not state or not state.alive then
		return
	end
	local session = DataService.Get(player)
	if not session then
		return
	end

	local now = os.clock()
	if session.data.unlockedZone < state.zone then
		if source == "tap" and now - session.lastNotice > 2 then
			session.lastNotice = now
			GameService.Notify(player, "Эта зона закрыта — откройте её в меню «Зоны»", "bad")
		end
		return
	end

	local combo = 0
	if source == "tap" then
		if now - session.lastClick < Config.ClickCooldown then
			return
		end
		-- Проверка расстояния на сервере (защита от читов)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or (root.Position - part.Position).Magnitude > Config.ClickRange + 10 then
			return
		end
		session.lastClick = now
		session.data.stats.taps += 1
		combo = GameService.RegisterCombo(session)
	end

	local damage, crit
	if source == "spirit" then
		damage, crit = Config.SpiritDamage(session.data), false
	else
		damage, crit = GameService.RollTapDamage(session)
	end
	if damage <= 0 then
		return
	end

	state.hp -= damage
	state.contributors[player] = true
	state.healthGui.Enabled = true
	state.fill.Size = UDim2.fromScale(math.clamp(state.hp / state.maxHp, 0, 1), 1)
	if state.kind == "boss" then
		part:SetAttribute("Hp", math.max(0, state.hp))
	end
	GameService.Fx(player, "damage", part.Position, damage, crit, combo, source)

	if state.hp > 0 then
		return
	end

	local position = part.Position
	killShadow(part, state)

	if state.kind == "boss" then
		-- Награда всем, кто бил Хранителя
		for contributor in state.contributors do
			if contributor.Parent then
				local amount, gems = GameService.RewardKill(contributor, state.zone, "boss", 0)
				GameService.Fx(contributor, "reward", position, amount, gems, false, "boss")
			end
		end
		zoneKills[state.zone] = 0
	else
		local amount, gems, lucky = GameService.RewardKill(player, state.zone, state.kind, combo)
		GameService.Fx(player, "reward", position, amount, gems, lucky, state.kind)
		zoneKills[state.zone] = math.min(Config.Boss.kills, (zoneKills[state.zone] or 0) + 1)
		if zoneKills[state.zone] >= Config.Boss.kills then
			spawnBoss(state.zone)
		end
	end
	updateKillCounter(state.zone)
end

-- kind: "normal", "gold", "boss" или "auto" (случайно: обычная или золотая)
function spawnShadow(zoneIndex: number, kind: string): BasePart
	if kind == "auto" then
		kind = if rng:NextNumber() < Config.Golden.spawnChance then "gold" else "normal"
	end
	local zone = Config.Zones[zoneIndex]
	local baseSize = 4 * (1 + (zoneIndex - 1) * 0.2)
	local size = if kind == "boss" then baseSize * 2.4 elseif kind == "gold" then baseSize * 0.85 else baseSize
	local hp = zone.shadowHp
		* (if kind == "boss" then Config.Boss.hpMultiplier elseif kind == "gold" then Config.Golden.hpMultiplier else 1)

	local position = if kind == "boss"
		then zoneCenter(zoneIndex) + Vector3.new(0, size / 2 + 2, 0)
		else randomPointInZone(zoneIndex, size / 2 + 1.5)
	local part = buildGhost(kind, zone, size, CFrame.new(position))

	local barColor = if kind == "boss" then Color3.fromRGB(255, 60, 80) elseif kind == "gold" then Color3.fromRGB(255, 210, 80) else zone.glowColor
	local healthGui, fill = buildHealthBar(part, size, barColor)
	if kind == "boss" then
		healthGui.Size = UDim2.fromOffset(200, 16)
		healthGui.MaxDistance = 200
		part:SetAttribute("IsBoss", true)
		part:SetAttribute("Zone", zoneIndex)
		part:SetAttribute("Hp", hp)
		part:SetAttribute("MaxHp", hp)
		part:SetAttribute("EndsAt", workspace:GetServerTimeNow() + Config.Boss.duration)
	end

	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = Config.ClickRange
	click.Parent = part

	local state = {
		zone = zoneIndex,
		kind = kind,
		hp = hp,
		maxHp = hp,
		alive = true,
		fill = fill,
		healthGui = healthGui,
		contributors = {}, -- [Player] = true
	}
	shadowStates[part] = state

	click.MouseClick:Connect(function(player)
		WorldService.Hit(player, part, "tap")
	end)

	part.Parent = shadowsFolder
	task.spawn(wander, part, state)
	return part
end

---------------------------------------------------------------------
-- Автоматические атаки: авто-ловля (Game Pass) и дух-помощник
---------------------------------------------------------------------

local function nearestShadow(position: Vector3, range: number, unlockedZone: number): BasePart?
	local nearest, nearestDistance = nil, range
	for part, state in shadowStates do
		if state.alive and state.zone <= unlockedZone then
			local distance = (part.Position - position).Magnitude
			-- Хранителя бьём в первую очередь
			if state.kind == "boss" then
				distance *= 0.3
			end
			if distance < nearestDistance then
				nearest, nearestDistance = part, distance
			end
		end
	end
	return nearest
end

local function autoCatchLoop()
	while true do
		task.wait(Config.AutoCatchInterval)
		for _, player in Players:GetPlayers() do
			local session = DataService.Get(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if session and session.passes.AutoCatch and root then
				local target = nearestShadow(root.Position, Config.AutoCatchRange, session.data.unlockedZone)
				if target then
					WorldService.Hit(player, target, "auto")
				end
			end
		end
	end
end

local function spiritLoop()
	while true do
		task.wait(Config.SpiritInterval)
		for _, player in Players:GetPlayers() do
			local session = DataService.Get(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if session and session.data.upgrades.spirit > 0 and root then
				local target = nearestShadow(root.Position, Config.SpiritRange, session.data.unlockedZone)
				if target then
					-- Сгусток летит от случайного питомца (или от игрока)
					local pets = PetService.GetPetParts(player)
					local from = if #pets > 0 then pets[math.random(1, #pets)].Position else root.Position + Vector3.new(0, 3, 0)
					GameService.Fx(player, "bolt", from, target)
					task.delay(0.25, WorldService.Hit, player, target, "spirit")
				end
			end
		end
	end
end

---------------------------------------------------------------------

function WorldService.Init()
	buildWorld()

	for zoneIndex = 1, #Config.Zones do
		zoneKills[zoneIndex] = 0
		updateKillCounter(zoneIndex)
		for _ = 1, Config.ShadowsPerZone do
			spawnShadow(zoneIndex, "auto")
		end
	end

	task.spawn(autoCatchLoop)
	task.spawn(spiritLoop)

	GameService.RegisterAction("teleport", function(player, session, zoneIndex)
		if type(zoneIndex) ~= "number" or zoneIndex % 1 ~= 0 then
			return
		end
		if zoneIndex < 1 or zoneIndex > session.data.unlockedZone then
			return
		end
		local character = player.Character
		if character then
			character:PivotTo(CFrame.new(zoneEntrance(zoneIndex)) * CFrame.Angles(0, math.rad(-90), 0))
		end
	end)
end

-- Номер зоны по координате X (для интерфейса и проверок).
function WorldService.ZoneAt(position: Vector3): number
	local index = math.floor((position.X + ZONE_SIZE / 2) / (ZONE_SIZE + ZONE_GAP)) + 1
	return math.clamp(index, 1, #Config.Zones)
end

return WorldService
]]></ProtectedString></Properties></Item>
