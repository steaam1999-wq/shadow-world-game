	Text = "💎 0",
	Parent = topBar,
})
UI.corner(10).Parent = gemsLabel
UI.stroke(Theme.Gem, 1.5, 0.3).Parent = gemsLabel

-- Плашка зоны и прогресса до Хранителя
local zonePill = UI.label({
	AnchorPoint = Vector2.new(0.5, 0),
