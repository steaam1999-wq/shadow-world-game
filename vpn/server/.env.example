# Публичный IP или домен сервера (ОБЯЗАТЕЛЬНО)
WG_HOST=203.0.113.10
# Внешний UDP-порт
WG_PORT=51820
# Первые три октета подсети VPN (сервер получит .1)
WG_SUBNET=10.13.13
# DNS для клиентов
WG_DNS=1.1.1.1, 1.0.0.1
# Какой трафик клиент пускает через VPN (0.0.0.0/0 = весь)
WG_ALLOWED_IPS=0.0.0.0/0
# Клиенты, создаваемые при первом запуске (через запятую)
PEERS=laptop,phone

# --- Веб-панель ---
# Пароль для входа (минимум 8 символов). Пусто — панель выключена.
WEB_PASSWORD=
# Порт панели на хосте
WEB_PORT=51821
# 127.0.0.1 — только через SSH-туннель (безопасно); 0.0.0.0 — из интернета (нужен HTTPS!)
WEB_LISTEN=127.0.0.1
# true, если панель открывается через HTTPS (cookie только по защищённому каналу)
WEB_SECURE_COOKIE=false
