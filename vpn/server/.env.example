# Публичный IP или домен сервера (ОБЯЗАТЕЛЬНО)
WG_HOST=203.0.113.10
# Внешний UDP-порт
WG_PORT=51820
# Первые три октета подсети VPN (сервер получит .1)
WG_SUBNET=10.13.13
# DNS для клиентов
WG_DNS=1.1.1.1, 1.0.0.1
# Какой трафик клиент пускает через VPN (0.0.0.0/0 = весь)
WG_ALLOWED_IPS=0.0.0.0/0
# Клиенты, создаваемые при первом запуске (через запятую)
PEERS=laptop,phone
